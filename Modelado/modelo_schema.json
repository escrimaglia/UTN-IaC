{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Devices Configuration Schema",
    "type": "object",
    "properties": {
        "modelo": {
            "type": "object",
            "properties": {
                "metadatos": {
                    "type": "object",
                    "properties": {
                        "proyecto": {
                            "type": "string",
                            "maxLength": 30
                        },
                        "version": {
                            "type": "string",
                            "maxLength": 20
                        },
                        "autor": {
                            "type": "string",
                            "maxLength": 50
                        },
                        "fecha_creacion": {
                            "type": "string",
                            "format": "date",
                            "$comment": "El dato es 2024-06-15, o sea una fecha sin hora: el formato correcto es date, no date-time. Con date-time este campo era invalido, pero el error no se veia: FormatChecker omite en silencio los formatos que no puede verificar, y date-time necesita el paquete rfc3339-validator, que no esta en las dependencias del modulo. Ver el capitulo 7 del libro."
                        }
                    },
                    "required": ["proyecto", "version", "autor", "fecha_creacion"]
                },
                "infra_spec": {
                    "type": "object",
                    "properties": {
                        "devices": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "hostname": {
                                        "type": "string",
                                        "maxLength": 20
                                    },
                                    "management": {
                                        "type": "object",
                                        "properties": {
                                            "ip": {
                                                "type": "string",
                                                "oneOf": [
                                                    {"format": "ipv4"}, 
                                                    {"format": "ipv6"}
                                                ]
                                            },
                                            "interface": {
                                                "type": "string",
                                                "maxLength": 30
                                            }
                                        },
                                        "required": ["ip", "interface"]
                                    },
                                    "connection": {
                                        "type": "object",
                                        "properties": {
                                            "device_type": {
                                                "type": "string",
                                                "maxLength": 30
                                            },
                                            "host": {
                                                "type": "string",
                                                "oneOf": [
                                                    {"format": "ipv4"},
                                                    {"format": "ipv6"}
                                                ]
                                            },
                                            "username": {
                                                "type": "string",
                                                "maxLength": 50
                                            },
                                            "password": {
                                                "type": "string",
                                                "maxLength": 50
                                            },
                                            "global_delay_factor": {
                                                "type":"number",
                                                "minimum": 0
                                            },
                                            "ssh_config_file": {
                                                "type": "string",
                                                "maxLength": 100
                                            }
                                        },
                                        "required": ["device_type", "host", "username", "password"]
                                    },
                                    "interfaces": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "maxLength": 30
                                                },
                                                "description": {
                                                    "type": "string",
                                                    "maxLength": 100
                                                },
                                                "mode": {
                                                    "type": "string",
                                                    "enum": ["access", "trunk"]
                                                },
                                                "trunk_mode": {
                                                    "type": ["string", "null"],
                                                    "enum": ["auto", "on", "off", null]
                                                },
                                                "allowed_vlans": {
                                                    "type": ["array", "null"],
                                                    "items": {
                                                        "type": "integer",
                                                        "minimum": 1,
                                                        "maximum": 30
                                                    }
                                                },
                                                "vlan": {
                                                    "type": ["integer", "null"],
                                                    "minimum": 1,
                                                    "maximum": 4094
                                                }
                                            },
                                            "required": ["name", "description", "mode"]
                                        }
                                    }
                                },
                                "required": ["hostname", "management", "connection", "interfaces"]
                            },
                            "minItems": 1
                        }
                    },
                    "required": ["devices"]
                }
            },
            "required": ["metadatos", "infra_spec"]
        }
    },
    "required": ["modelo"]
}
